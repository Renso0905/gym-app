{
  "name": "gym-app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal gym-tracking progressive web app.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
